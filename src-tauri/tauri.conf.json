{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OwlSSH",
  "version": "0.1.0",
  "identifier": "dev.deskezz.owlssh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OwlSSH",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Deskezz-exe",
    "copyright": "Copyright (c) 2026 Deskezz-exe. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "SSH client with a live server dashboard and a built-in MCP server",
    "longDescription": "OwlSSH is a desktop SSH client with low-latency terminals, a live server dashboard, a two-pane file manager, snippets and an MCP server that lets AI assistants work on your servers with your approval.",
    "homepage": "https://github.com/Deskezz-exe/OwlSSH-with-mcp",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "net"
      }
    }
  }
}
